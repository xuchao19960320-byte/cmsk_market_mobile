{
 "name": "cmsk-marketing-analysis",
 "version": "1.0.0",
 "private": true,
 "type": "module",
 "engines": {
  "node": ">=22.12.0"
 },
 "scripts": {
  "dev": "vite --host 127.0.0.1 --port 8177 --strictPort",
  "typecheck": "tsc --noEmit",
  "build": "npm run typecheck && vite build",
  "preview": "wrangler dev --ip 127.0.0.1 --port 8178",
  "deploy": "npm run build && wrangler deploy",
  "deploy:check": "npm run build && wrangler deploy --dry-run --outdir .cloudflare-build",
  "test": "vitest run",
  "check:rules": "node scripts/check-rules.mjs"
 },
 "dependencies": {
  "@ant-design/cssinjs": "^1.24.0",
  "@ant-design/icons": "^6.0.0",
  "antd": "^5.27.0",
  "dayjs": "^1.11.0",
  "echarts": "^6.0.0",
  "react": "^19.0.0",
  "react-dom": "^19.0.0",
  "react-router-dom": "^7.0.0",
  "zustand": "^5.0.0"
 },
 "devDependencies": {
  "@cloudflare/workers-types": "^5.20261023.1",
  "@types/node": "^24.0.0",
  "@types/react": "^19.0.0",
  "@types/react-dom": "^19.0.0",
  "@vitejs/plugin-react": "^5.0.0",
  "autoprefixer": "^10.4.0",
  "postcss": "^8.5.0",
  "prettier": "^3.9.10",
  "tailwindcss": "^3.4.0",
  "typescript": "^5.9.0",
  "vite": "^7.0.0",
  "vitest": "^5.0.5",
  "wrangler": "^4.0.0"
 }
}
